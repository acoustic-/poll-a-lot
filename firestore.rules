service cloud.firestore {
  match /databases/{database}/documents {
    // Shared by duelBallots create/update below. Per-entry validation
    // (winnerId in [aId,bId], aId != bId) can't be expressed here — the rules
    // language has no array iteration — so only the last appended pick is
    // spot-checked as a cheap guard against obviously bad writes; the rest is
    // enforced client-side and again in `rankFromDuels`, which discards any
    // malformed or dangling record either way.
    function validDuelBallotShape() {
      return request.resource.data.picks is list
          && request.resource.data.picks.size() <= 500
          && request.resource.data.updatedAt is number
          && request.resource.data.voterRef is map
          && (request.resource.data.picks.size() == 0 || (
               request.resource.data.picks[request.resource.data.picks.size() - 1].aId is string
               && request.resource.data.picks[request.resource.data.picks.size() - 1].bId is string
               && request.resource.data.picks[request.resource.data.picks.size() - 1].aId
                  != request.resource.data.picks[request.resource.data.picks.size() - 1].bId
               && request.resource.data.picks[request.resource.data.picks.size() - 1].winnerId in [
                    request.resource.data.picks[request.resource.data.picks.size() - 1].aId,
                    request.resource.data.picks[request.resource.data.picks.size() - 1].bId
                  ]
             ));
    }

    match /polls/{pollId} {
      allow get: if true;
      // Only list your own polls (used by the "My Polls" screen) — prevents
      // enumerating every poll in the database.
      allow list: if request.auth != null && request.auth.uid == resource.data.owner.id;
      // Poll creation is gated to signed-in Google users client-side
      // (add-poll.component.html); enforce that server-side too.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.owner.id;
      // Only the owner may change poll settings/delete the poll, except for
      // `descriptionAI`/`pollItems`, which any voter's action (add/remove/toggle
      // an item) legitimately clears via PollComponent.clearDescriptionAI(),
      // including anonymous localUserId voters with no request.auth at all.
      allow update: if (request.auth != null && request.auth.uid == resource.data.owner.id)
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['descriptionAI', 'pollItems']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.owner.id;

      // Poll items. Anonymous (localUserId) visitors vote, react and add items
      // with no request.auth at all, so a rule can never prove WHO an anonymous
      // caller is — only what they may touch. What it can do is (a) stop anyone
      // from touching what a Google-signed-in person owns, (b) keep each kind of
      // change to the fields it is allowed to change, and (c) enforce the lock and
      // the "allow adding" switch the UI has so far enforced alone.
      //
      // Residual, accepted gap: an item added by a local-name user (a creator with a
      // `localUserId` but no Google `id`, or a legacy item with no creator) can still
      // be removed, or have its description edited, by any anonymous caller. The
      // `localUserId` is a random id the browser wrote into the item; the request
      // carries nothing that proves it, so there is nothing to compare it against.
      // The UI already refuses this; only a hand-made request gets through. Closing
      // it means signing local-name users into Firebase Anonymous Auth and keying
      // `creator.localUserId` to `request.auth.uid`.
      match /pollItems/{pollItemId} {
        function pollPath() {
          return /databases/$(database)/documents/polls/$(pollId);
        }
        function pollData() {
          return get(pollPath()).data;
        }
        function isPollOwner() {
          return request.auth != null && request.auth.uid == pollData().owner.id;
        }
        // `locked` is a timestamp once the owner closes voting, absent/null before.
        function pollOpen() {
          return pollData().get('locked', null) == null;
        }
        function creatorId(item) {
          return item.get('creator', {}).get('id', null);
        }
        // The caller is the Google user who created the item.
        function isGoogleCreator(item) {
          return request.auth != null && creatorId(item) == request.auth.uid;
        }
        // A creator with no Google id (a local-name user): nothing to check the
        // caller against, see the residual gap above.
        function creatorUnverifiable(item) {
          return creatorId(item) == null;
        }
        function changedKeys() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        allow read: if true;

        // New items: stamped with the right poll and id; a creator claiming a
        // Google id must be that user; and anyone but the owner needs the poll to
        // be open and to allow adding.
        allow create: if request.resource.data.pollId == pollId
                      && request.resource.data.id == pollItemId
                      && exists(pollPath())
                      && (creatorUnverifiable(request.resource.data)
                          || (request.auth != null
                              && creatorId(request.resource.data) == request.auth.uid))
                      && (isPollOwner()
                          || (pollOpen() && pollData().get('allowAdd', false) == true));

        // The AI "why vote for this" cache is written by whoever opens the movie
        // dialog first, locked or not. Everything else is split by who may do it.
        allow update: if changedKeys().hasOnly(['suggestionAI'])
                      || ((isPollOwner() || pollOpen()) && (
                            // Voting, point votes and reactions: any visitor.
                            changedKeys().hasOnly(['voters', 'reactions'])
                            // Description: the creator, or the owner.
                            || (changedKeys().hasOnly(['description', 'tags'])
                                && (isPollOwner()
                                    || isGoogleCreator(resource.data)
                                    || creatorUnverifiable(resource.data)))
                            // Curation (hide, select, reorder): the owner only.
                            || (isPollOwner()
                                && changedKeys().hasOnly(['visible', 'selected', 'order']))
                          ));

        // The poll's owner, or the item's creator while the poll is open. The
        // poll's own deletion removes the poll doc first and its items after, so
        // items of a poll that no longer exists may be cleaned up by anyone.
        allow delete: if !exists(pollPath())
                      || isPollOwner()
                      || (pollOpen()
                          && (isGoogleCreator(resource.data)
                              || creatorUnverifiable(resource.data)));
      }

      // Ranked Duels: one ballot doc per voter, id = voterKey(user). Single
      // writer per doc (that one voter), so appending a pick never races another
      // voter — unlike a shared array on the poll/pollItems docs.
      //
      // Broadly open like `pollItems` above for a voter's OWN first write —
      // anonymous localUserId voters write here with no request.auth at all,
      // same as everywhere else in the app. But once a ballot has been claimed
      // by a signed-in voter (its stored `voterRef.id` is set), `update` NO
      // LONGER accepts `request.auth == null` at all — an unauthenticated
      // request can never touch a Google voter's ballot again, not even to
      // wipe it via an empty `picks: []` (a prior version of this rule let
      // `request.auth == null ||` short-circuit that check entirely, which
      // defeated the whole point of keying the doc by uid). `voterRef.id` is
      // also pinned equal to its existing value on update — only `id` (the
      // identity anchor), not the whole map, since `name`/`photoURL`-ish
      // fields may legitimately change between picks — so a write can't
      // re-identify whose ballot this is.
      //
      // Residual, accepted gap (same class as every client-chosen id in this
      // app): an anonymous client can still create-squat an UNCLAIMED voterKey
      // — including one that happens to equal a real uid nobody has used yet —
      // since `create` has nothing to compare against. It cannot touch a
      // ballot that already exists, which is what `update`'s stricter check is
      // for.
      match /duelBallots/{voterKey} {
        allow read: if true;

        allow create: if (request.auth == null || request.auth.uid == voterKey)
                      && validDuelBallotShape();

        // `.get('id', null)` (not dot access) because an anonymous voter's
        // stored `voterRef` never has an `id` key at all, and dereferencing a
        // genuinely absent map key errors out the whole expression (denying
        // even the safe branch) instead of just being falsy.
        allow update: if (
                            resource.data.voterRef.get('id', null) != null
                              ? request.auth != null
                                && request.auth.uid == resource.data.voterRef.get('id', null)
                              : (request.auth == null || request.auth.uid == voterKey)
                          )
                      && request.resource.data.voterRef.get('id', null)
                         == resource.data.voterRef.get('id', null)
                      && validDuelBallotShape();

        // Owner clears every ballot ("clear duels" in the edit dialog); a
        // signed-in voter clears their own (`request.auth.uid` == voterKey doc
        // id). Anonymous voters redo their duels by overwriting picks via
        // update, not delete.
        allow delete: if request.auth != null
                      && (request.auth.uid == voterKey
                          || request.auth.uid == get(/databases/$(database)/documents/polls/$(pollId)).data.owner.id);
      }
    }
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // The first world-readable, user-writable collection in the app — voters'
    // display name/photo, resolved live at render time (UserIdentityService)
    // instead of being frozen into each vote. Shaped tightly since anyone can
    // read it and only its own owner can write it.
    match /publicProfiles/{userId} {
      // `get` (a single doc by a uid the caller already has — from a poll's
      // voters/creator, which it's separately allowed to read) stays open.
      // `list` (a query, e.g. a `where(documentId(), "in", [...])` batch)
      // does not: rules can't tell "resolve this poll's real voters" apart
      // from "dump the whole collection," and Firebase Auth uids aren't
      // guessable in bulk, so denying `list` closes the enumeration/scrape
      // gap without needing a server-side allowlist. UserIdentityService
      // fetches by individual getDoc() calls for exactly this reason, not a
      // batched `in` query.
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'updatedAt'])
                   && request.resource.data.uid == userId
                   && request.resource.data.displayName is string
                   && request.resource.data.displayName.size() >= 1
                   && request.resource.data.displayName.size() <= 30
                   && (request.resource.data.photoURL == null || request.resource.data.photoURL is string)
                   && request.resource.data.updatedAt is number;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    // Everything else (e.g. tokens/**, written only by Cloud Functions via the
    // Admin SDK, which bypasses these rules) is denied by default.
  }
}
