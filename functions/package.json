{
  "name": "functions",
  "scripts": {
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint --ext .js,.ts .",
    "test": "NODE_OPTIONS=--no-experimental-strip-types jasmine --config=spec/support/jasmine.json",
    "build": "tsc && cp ../dist/browser/index.csr.html ./lib/index.template.html && cp ../dist/browser/assets/img/poll-a-lot-logo-white.svg ./lib/watermark.svg",
    "build:watch": "tsc --watch",
    "serve": "yarn build && firebase emulators:start --only functions",
    "shell": "yarn build && firebase functions:shell",
    "start": "yarn shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "resolutions": {
    "brace-expansion": ">=5.0.8",
    "uuid": ">=11.1.1"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.0",
    "node-fetch": "^2.7.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/jasmine": "^6.0.0",
    "@types/node": "22.14.1",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "jasmine": "^6.3.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.0"
  },
  "private": true
}
